CalTransFiltered_301Bbs$Soil_source_elevation <- as.factor(CalTransFiltered_301Bbs$Soil_source_elevation)
CalTransFiltered_301Bbs$Recipient_elevation <- as.factor(CalTransFiltered_301Bbs$Recipient_elevation)

# Function to produce nice anova tables
library(kableExtra)
library(report)
print_lmer_anova <- function(formula, data, p_cutoff = 0.05) {
model <- lmer(formula, data = data)
anova_res <- as.data.frame(car::Anova(model))
anova_res <- anova_res %>%
dplyr::mutate(
Predictor = rownames(anova_res),
Predictor = ifelse(`Pr(>Chisq)` < p_cutoff,
cell_spec(Predictor, bold = TRUE),
Predictor)
) %>%
dplyr::select(Predictor, everything())
rownames(anova_res) <- NULL
anova_kable <- kable(anova_res, escape = FALSE, format = "html") %>%
kable_styling()
report_kable <- kable(as.data.frame(report_table(model)), escape = FALSE, format = "html") %>%
kable_styling()
return(anova_kable)
return(report_kable)
}
print_glmer_anova <- function(formula, data, p_cutoff = 0.05) {
model <- glmmTMB(formula, data = data, family = binomial)
anova_res <- as.data.frame(car::Anova(model))
anova_res <- anova_res %>%
dplyr::mutate(
Predictor = rownames(anova_res),
Predictor = ifelse(`Pr(>Chisq)` < p_cutoff,
cell_spec(Predictor, bold = TRUE),
Predictor)
) %>%
dplyr::select(Predictor, everything())
rownames(anova_res) <- NULL
anova_kable <- kable(anova_res, escape = FALSE, format = "html") %>%
kable_styling()
report_kable <- kable(as.data.frame(report_table(model)), escape = FALSE, format = "html") %>%
kable_styling()
return(anova_kable)
return(report_kable)
}
ReactNormPlot <- function(data, Y, Ylabel) {
# Convert Y string to symbol
Y_sym <- rlang::sym(Y)
# Summarize data
ReactNormY <- data %>%
dplyr::mutate(Recipient_elevation = as.factor(Recipient_elevation)) %>%
summarySE(measurevar = Y,
groupvars = c("Recipient_elevation", "Seed_source_elevation"),na.rm = TRUE) %>%
dplyr::mutate(Recipient_elevation2 = as.numeric(as.character(Recipient_elevation)))
# Set up position dodge
pd <- position_dodge(75)
# Build plot
YPlot <- ReactNormY %>%
ggplot(aes(
x = Recipient_elevation2,
y = !!Y_sym,
shape = Recipient_elevation,
color = Seed_source_elevation
)) +
theme_classic() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, size = 10, colour = "black",face="bold"),
axis.text.y = element_text(colour = "black", size = 10,face="bold"),
axis.title = element_text(size = 10,face="bold"),
legend.position = "none",
plot.title = element_text(colour = "black", size = 10, face = "bold", hjust = 0.33)
) +
geom_errorbar(aes(ymin = !!Y_sym - se, ymax = !!Y_sym + se),
width = 150, size = 1, position = pd) +
geom_point(position = pd, size = 8) +
geom_line(aes(group = Seed_source_elevation), position = pd, size = 1) +
ggtitle("") +
ylab(Ylabel) +
xlab("Transplant elevation") +
scale_color_manual(values = c("#E11919", "#EFA1A1", "#184CA1")) +
scale_shape_manual(values = c(16, 17, 15)) +
scale_x_continuous(breaks = c(700, 1000, 1700))
# Return the plot
return(YPlot)
}
ReactNormPlot2 <- function(data, Y, Ylabel) {
# Convert Y string to symbol
Y_sym <- rlang::sym(Y)
# Summarize data
ReactNormY <- data %>%
dplyr::mutate(Recipient_elevation = as.factor(Recipient_elevation)) %>%
summarySE(
measurevar = Y,
groupvars = c("Recipient_elevation", "Seed_source_elevation"),
na.rm = TRUE
) %>%
dplyr::mutate(Recipient_elevation2 = as.numeric(as.character(Recipient_elevation)))
# Set up position dodge
pd <- position_dodge(150)
pd2 <-position_dodge(10)
# Build plot
YPlot <- ggplot() +
# ---- SUMMARY LAYERS ----
geom_errorbar(
data = ReactNormY,
aes(
x = Recipient_elevation2,
ymin = !!Y_sym - se,
ymax = !!Y_sym + se,
color = Seed_source_elevation
),
width = 150,
size = 1,
position = pd
) +
geom_point(
data = ReactNormY,
aes(
x = Recipient_elevation2,
y = !!Y_sym,
color = Seed_source_elevation
),
shape = 18,
size = 8,
position = pd
) +
geom_line(
data = ReactNormY,
aes(
x = Recipient_elevation2,
y = !!Y_sym,
group = Seed_source_elevation,
color = Seed_source_elevation
),
size = 1,
position = pd
) +
# ---- RAW POINTS (transparent) ----
geom_point(
data = data,
aes(
x = as.numeric(as.character(Recipient_elevation)),
y = !!Y_sym,
color = Seed_source_elevation,
shape = as.factor(Soil_source_elevation),
group = Seed_source_elevation
),
alpha = 0.30,
size = 3,
position = position_jitterdodge(jitter.width = 50, jitter.height = 0, dodge.width = 150)) +
# ---- THEMES & LABELS ----
theme_classic() +
theme(
axis.text.x = element_text(angle = 45, hjust = 1, size = 15, colour = "black"),
axis.text.y = element_text(colour = "black", size = 15),
axis.title  = element_text(size = 15),
legend.position = "none",
plot.title = element_text(colour = "black", size = 15, hjust = 0.33)
) +
scale_color_manual(values = c("#E11919", "#C6A3E0", "#184CA1")) +
#    scale_shape_manual(values = c(16,17,15,18,0)) +
scale_x_continuous(breaks = c(700, 1000, 1700)) +
xlab("Transplant elevation") +
ylab(Ylabel) +
ggtitle("")
return(YPlot)
}
